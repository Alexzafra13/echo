# ============================================
# Echo Music Server — Configuration
# ============================================
# Optional. docker-compose.yml works without a .env file:
# PostgreSQL and Redis use built-in passwords (internal services,
# not exposed) and the JWT secrets are generated by the container
# on first start and kept in the echo_data volume (/app/data/secrets.env).
#
# To use random passwords instead, run ./install.sh --secure
# or copy this file to .env and set your own values.
# ============================================

# Database (user and database name are fixed to "echo")
POSTGRES_PASSWORD=change_me

# Cache
REDIS_PASSWORD=change_me

# Server port (default: 4567)
# ECHO_PORT=4567
